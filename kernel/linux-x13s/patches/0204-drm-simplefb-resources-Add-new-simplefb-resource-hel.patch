 drivers/gpu/drm/Makefile                 |   1 +
 drivers/gpu/drm/drm_simplefb_resources.c | 334 +++++++++++++++++++++++
 include/drm/simplefb_resources.h         |  43 +++
 4 files changed, 382 insertions(+)
 create mode 100644 drivers/gpu/drm/drm_simplefb_resources.c
 create mode 100644 include/drm/simplefb_resources.h

